{
  "extraKnownMarketplaces": {
    "typesafe-ai": {
      "source": {
        "source": "github",
        "repo": "typesafe-ai/skills"
      }
    },
    "hello-word-mods": {
      "source": {
        "source": "github",
        "repo": "AndrzejZGdyni/hello-word"
      }
    }
  },
  "enabledPlugins": {
    "typesafe@typesafe-ai": true,
    "context-bar@hello-word-mods": true
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ]
      }
    ]
  }
}
